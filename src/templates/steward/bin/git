#!/usr/bin/env node
import { spawnSync } from "node:child_process";
import { accessSync, constants, existsSync, mkdirSync, mkdtempSync, readdirSync, rmSync, statSync, symlinkSync } from "node:fs";
import { tmpdir } from "node:os";
import { delimiter, join, resolve } from "node:path";

function realGit() {
  const self = statSync(process.argv[1]);
  for (const directory of (process.env.PATH ?? "").split(delimiter).filter(Boolean)) {
    const candidate = resolve(directory, "git");
    try {
      const file = statSync(candidate);
      if (!file.isFile() || (file.dev === self.dev && file.ino === self.ino)) continue;
      accessSync(candidate, constants.X_OK);
      return candidate;
    } catch {
      // PATH entries can be missing or inaccessible.
    }
  }
  throw new Error();
}

function readConfig(git, args, env, allowMissing = false, directoryArgs = []) {
  const config = spawnSync(git, [...directoryArgs, "config", "--null", ...args], {
    env, encoding: "utf8", timeout: 5_000, killSignal: "SIGKILL",
    stdio: ["ignore", "pipe", "ignore"],
  });
  if (config.status !== 0 && !(allowMissing && config.status === 1 && !config.stdout)) {
    throw new Error();
  }
  return (config.stdout ?? "").split("\0").filter(Boolean).map(record => {
    const separator = record.indexOf("\n");
    return separator < 0 ? [record, ""] : [record.slice(0, separator), record.slice(separator + 1)];
  });
}

function githubHttps(url) {
  const scp = /^(?:[^/@:\s]+@)?(?:ssh\.)?github\.com\.?:\/?(.+)$/i.exec(url);
  if (scp) {
    if (!/^[\w.-]+\/[\w.-]+\/?$/.test(scp[1])) throw new Error();
    return "https://github.com/" + scp[1].replace(/\/$/, "");
  }
  // URL discards embedded credentials and default ports. It lowercases hosts
  // only for special schemes, so ssh: and git: hosts are lowercased here.
  let parsed;
  try { parsed = new URL(url); } catch { return; }
  const host = parsed.hostname.toLowerCase().replace(/\.$/, "");
  const alternateSsh = host === "ssh.github.com" && parsed.protocol === "ssh:";
  if (host !== "github.com" && !alternateSsh) return;
  if (!["https:", "http:", "ssh:", "git:"].includes(parsed.protocol) ||
      (parsed.port && !(parsed.protocol === "ssh:" && parsed.port === (alternateSsh ? "443" : "22"))) ||
      parsed.search || parsed.hash || !/^\/[\w.-]+\/[\w.-]+\/?$/.test(parsed.pathname)) {
    throw new Error();
  }
  return "https://github.com" + parsed.pathname.replace(/\/$/, "");
}

const TRANSPORT_COMMANDS = new Set(["clone", "fetch", "pull", "push", "ls-remote"]);
// Global options whose value is the following argument.
const GLOBAL_VALUE_OPTIONS = new Set(["-C", "-c", "--git-dir", "--work-tree", "--namespace",
  "--super-prefix"]);
// Global options that select the repository or configuration Git will use.
const REPOSITORY_OPTIONS = new Set(["-C", "-c", "--git-dir", "--work-tree", "--bare"]);
const REPOSITORY_OPTION_PREFIXES = ["--git-dir=", "--work-tree=", "--config-env="];

/** Split Git's leading global options from the subcommand, as Git parses them. */
function parseGlobalOptions(args) {
  const repositoryArgs = [];
  for (let i = 0; i < args.length; i++) {
    const arg = args[i];
    if (!arg.startsWith("-")) return { command: i, repositoryArgs };
    if (GLOBAL_VALUE_OPTIONS.has(arg)) {
      if (i + 1 >= args.length) break;
      if (REPOSITORY_OPTIONS.has(arg)) repositoryArgs.push(arg, args[i + 1]);
      i++;
    } else if (REPOSITORY_OPTIONS.has(arg) || REPOSITORY_OPTION_PREFIXES.some(p => arg.startsWith(p))) {
      repositoryArgs.push(arg);
    }
  }
  return { command: -1, repositoryArgs };
}

// GIT_CONFIG_COUNT/KEY/VALUE carry every steward setting; older Git ignores them.
function requireConfigEnvironment(git, env) {
  const version = spawnSync(git, ["--version"], {
    env, encoding: "utf8", timeout: 5_000, killSignal: "SIGKILL",
    stdio: ["ignore", "pipe", "ignore"],
  });
  const match = /^git version (\d+)\.(\d+)/.exec(version.stdout ?? "");
  if (!match || Number(match[1]) < 2 || (Number(match[1]) === 2 && Number(match[2]) < 31)) {
    throw new Error();
  }
}

// Global keys that can select credentials, transport destinations or askpass.
const CREDENTIAL_GLOBAL_KEY = /^(?:credential|http|url|remote|include|includeif)\.|^core\.(?:askpass|sshcommand)$/i;
const CREDENTIAL_HOME_ENTRIES = new Set([".netrc", "_netrc", ".gitconfig", ".git-credentials", ".config"]);

function linkEntries(source, target, skip) {
  if (!existsSync(source)) return;
  for (const entry of readdirSync(source)) {
    if (!skip.has(entry)) symlinkSync(join(source, entry), join(target, entry));
  }
}

/**
 * Build a HOME that mirrors the operator's, without the files Git and curl
 * read credentials from, so hooks, signing and tools keep their settings.
 */
function isolatedHome(env) {
  const realHome = env.HOME;
  if (!realHome) throw new Error();
  const realConfig = env.XDG_CONFIG_HOME || join(realHome, ".config");
  const home = mkdtempSync(join(tmpdir(), "march-steward-git-"));
  try {
    linkEntries(realHome, home, CREDENTIAL_HOME_ENTRIES);
    const config = join(home, ".config");
    mkdirSync(join(config, "git"), { recursive: true });
    linkEntries(realConfig, config, new Set(["git"]));
    linkEntries(join(realConfig, "git"), join(config, "git"), new Set(["config", "credentials"]));
    return { home, config, gnupg: join(realHome, ".gnupg") };
  } catch (error) {
    rmSync(home, { recursive: true, force: true });
    throw error;
  }
}

function run() {
  const git = realGit();
  const args = process.argv.slice(2);
  const env = { ...process.env };
  for (const name of Object.keys(env)) {
    if (/^GIT_(CONFIG(?:_|$)|TRACE|CURL_VERBOSE$|EXEC_PATH$|SSL_(?:CERT|KEY|NO_VERIFY)$)/.test(name) ||
        /^(?:GH_TOKEN|GITHUB_TOKEN|GH_ENTERPRISE_TOKEN|GITHUB_ENTERPRISE_TOKEN|MARCH_TESSERA_CLIENT_KEY)$/.test(name)) {
      delete env[name];
    }
  }

  requireConfigEnvironment(git, env);
  // Read the same repository and configuration Git will use for this command.
  const { command, repositoryArgs } = parseGlobalOptions(args);
  // Keep the operator's non-credential global settings (identity, signing, hooks).
  // --get-regexp exits 1 (not 128 like --list) when no global config exists.
  const global = readConfig(git, ["--global", "--includes", "--get-regexp", "."], env, true, repositoryArgs)
    .filter(([name]) => !CREDENTIAL_GLOBAL_KEY.test(name));
  // Git's HTTPS transport can use netrc before asking any credential helper.
  const { home, config: configHome, gnupg } = isolatedHome(env);
  try {
    if (!env.GNUPGHOME && existsSync(gnupg)) env.GNUPGHOME = gnupg;
    Object.assign(env, {
      HOME: home, CURL_HOME: home, XDG_CONFIG_HOME: configHome, NETRC: "/dev/null",
      GIT_CONFIG_NOSYSTEM: "1", GIT_CONFIG_GLOBAL: "/dev/null",
      GIT_TERMINAL_PROMPT: "0", GIT_ASKPASS: "/bin/false",
    });

    const config = readConfig(git, ["--list", "--includes"], env, false, repositoryArgs);
    const localKeys = new Set(config.map(([name]) => name));
    const settings = global.filter(([name]) => !localKeys.has(name));
    for (const [name, value] of config) {
      // Git prefers the longest rewrite match. A repository-level rule must
      // not supersede the steward's rewrite of GitHub transport URLs.
      if (/^url\..+\.(?:insteadof|pushinsteadof)$/i.test(name) &&
          (githubHttps(name.slice(4, name.lastIndexOf("."))) || githubHttps(value))) {
        throw new Error();
      }
      if (/^http\.(?:.+\.)?extraheader$/i.test(name)) settings.push([name, ""]);
      if (/^http\.(?:.+\.)?(?:cookiefile|sslcert|sslkey)$/i.test(name)) {
        settings.push([name, "/dev/null"]);
      }
      if (/^http\.(?:.+\.)?(?:savecookies|emptyauth|followredirects)$/i.test(name)) {
        settings.push([name, "false"]);
      }
      if (/^remote\..+\.(?:url|pushurl)$/i.test(name)) {
        const normalized = githubHttps(value);
        if (normalized && normalized !== value) settings.push([`url.${normalized}.insteadOf`, value]);
      }
    }

    settings.push(
      ["url.https://github.com/.insteadOf", "git@github.com:"],
      ["url.https://github.com/.insteadOf", "ssh://git@github.com/"],
      ["url.https://github.com/.insteadOf", "ssh://git@github.com:22/"],
      ["credential.https://github.com/.helper", ""],
      ["credential.https://github.com/.helper", "!march tessera git-credential"],
      ["credential.https://github.com/.useHttpPath", "true"],
      ["credential.https://github.com/.interactive", "false"],
      ["http.https://github.com/.emptyAuth", "false"],
      ["http.https://github.com/.followRedirects", "false"],
    );

    // An explicit transport URL follows the same policy as a configured remote.
    // Only transport subcommands take URL operands; patterns, messages and
    // other command data must reach Git unchanged.
    const transport = command >= 0 && TRANSPORT_COMMANDS.has(args[command]);
    const normalizedArgs = args.map((arg, i) => {
      if (!transport || i <= command) return arg;
      const prefix = arg.startsWith("--repo=") ? "--repo=" : "";
      if (!prefix && arg.startsWith("-")) return arg;
      const normalized = githubHttps(arg.slice(prefix.length));
      return normalized ? prefix + normalized : arg;
    });
    env.GIT_CONFIG_COUNT = String(settings.length);
    for (const [i, [name, value]] of settings.entries()) {
      env[`GIT_CONFIG_KEY_${i}`] = name;
      env[`GIT_CONFIG_VALUE_${i}`] = value;
    }

    return spawnSync(git, normalizedArgs, {
      env, stdio: "inherit", timeout: 600_000, killSignal: "SIGKILL",
    });
  } finally {
    rmSync(home, { recursive: true, force: true });
  }
}

try {
  const result = run();
  if (result.error) throw result.error;
  if (result.signal) process.kill(process.pid, result.signal);
  process.exitCode = result.status ?? 1;
} catch {
  process.stderr.write("Tessera Git: unable to run Git with isolated credentials.\n");
  process.exitCode = 1;
}
