{
  "name": "@balexda/march",
  "version": "0.3.3",
  "description": "CLI for the March agentic-development workflow: snapshot a worktree, dispatch a sandboxed spawn, and deploy the March skills for Claude Code.",
  "type": "module",
  "bin": {
    "march": "./dist/cli.js"
  },
  "scripts": {
    "docs:contracts:check": "node scripts/docs-contracts/check.mjs",
    "docs:contracts:extract": "tsup src/contracts/autogen-command-cli.ts --format esm --out-dir .cache/docs-contracts-extract --clean --external typescript --silent && node .cache/docs-contracts-extract/autogen-command-cli.js",
    "pretest": "npm run build",
    "test": "npm run test:l0 && npm run test:l1 && npm run test:l2-cassette && npm run test:l3-cassette",
    "test:vitest": "vitest run",
    "test:l0": "node scripts/run-layered-tests.mjs l0",
    "test:l1": "node scripts/run-layered-tests.mjs l1",
    "test:l2-cassette": "node scripts/run-layered-tests.mjs l2-cassette",
    "test:l3-cassette": "node scripts/run-layered-tests.mjs l3-cassette",
    "test:taxonomy": "node scripts/test-taxonomy.mjs",
    "skills:generate": "node scripts/generate-skills.mjs",
    "build": "tsup src/cli.ts --format esm --clean && tsup src/modules/v0.ts --format esm --dts && npm run skills:generate",
    "build:spawn-claude-image": "docker build -t march-spawn-claude:latest -f docker/spawn-claude.Dockerfile docker",
    "build:spawn-codex-image": "docker build -t march-spawn-codex:latest -f docker/spawn-codex.Dockerfile docker",
    "build:spawn-claude-jvm-image": "docker build -t march-spawn-claude-jvm:latest -f docker/spawn-claude-jvm.Dockerfile docker",
    "build:spawn-codex-jvm-image": "docker build -t march-spawn-codex-jvm:latest -f docker/spawn-codex-jvm.Dockerfile docker",
    "build:hatchery-image": "docker build $(sh scripts/build-args.sh) -t march-hatchery:latest -f docker/hatchery.Dockerfile .",
    "build:castra-image": "docker build $(sh scripts/build-args.sh) -t march-castra:latest -f docker/castra.Dockerfile .",
    "build:tessera-image": "docker build $(sh scripts/build-args.sh) -t march-tessera:latest -f docker/tessera.Dockerfile .",
    "build:statio-image": "docker build $(sh scripts/build-args.sh) -t march-statio:latest -f docker/statio.Dockerfile .",
    "build:brood-image": "docker build $(sh scripts/build-args.sh) -t march-brood:latest -f docker/brood.Dockerfile .",
    "build:herald-image": "docker build $(sh scripts/build-args.sh) -t march-herald:latest -f docker/herald.Dockerfile .",
    "build:legate-image": "docker build $(sh scripts/build-args.sh) -t march-legate:latest -f docker/legate.Dockerfile .",
    "build:images": "npm run build:castra-image && npm run build:statio-image && npm run build:tessera-image && npm run build:hatchery-image && npm run build:brood-image && npm run build:herald-image && npm run build:legate-image",
    "deploy:local": "npm run build && npm run build:images && node dist/cli.js upgrade",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test:work-module-package": "npm run build && node scripts/test-work-module-package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Balexda/March.git"
  },
  "homepage": "https://github.com/Balexda/March#readme",
  "bugs": {
    "url": "https://github.com/Balexda/March/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src/templates",
    "docker"
  ],
  "dependencies": {
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/api-logs": "^0.223.2",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.2",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.2",
    "@opentelemetry/resources": "^2.12.1",
    "@opentelemetry/sdk-logs": "^0.223.2",
    "@opentelemetry/sdk-metrics": "^2.12.1",
    "@opentelemetry/sdk-trace-base": "^2.12.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "commander": "^15.1.0",
    "dotprompt": "^1.1.2",
    "fastify": "^5.12.8",
    "picocolors": "^1.1.1",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "exports": {
    "./modules/v0": {
      "types": "./dist/v0.d.ts",
      "import": "./dist/v0.js"
    }
  }
}
