    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Brood session-state + teardown service. DOWN when /readyz fails (docker or git missing) or it stops answering. The state comes from the legate's readiness probe, run every tick (march_stack_service_state): whether the service can do its job, not only whether it is alive. If the legate is not reporting, the card falls back to this service's heartbeat. For the remedy behind a red card, see the console's System panel or `march status`.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "DOWN",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "NOT DEPLOYED",
                  "color": "text",
                  "index": 1
                },
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 2
                },
                "1": {
                  "text": "DEGRADED",
                  "color": "orange",
                  "index": 3
                },
                "2": {
                  "text": "OK",
                  "color": "green",
                  "index": 4
                }
              }
            }
          ],
          "noValue": "DOWN",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "text",
                "value": -1
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "pluginVersion": "12.2.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(max(march_stack_service_state{service=\"brood\",state=\"ok\"}) * 2 + max(march_stack_service_state{service=\"brood\",state=\"degraded\"}) - max(march_stack_service_state{service=\"brood\",state=\"absent\"}))\nor\n((sum(increase(march_brood_heartbeat_total[5m])) > bool 0) * 2)",
          "legendFormat": "Brood",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Brood",
      "type": "stat"
    },
